{
  "name": "jasper-ui",
  "version": "1.4.0",
  "packageManager": "npm@11.20.0",
  "scripts": {
    "postinstall": "patch-package",
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --configuration production --source-map --localize",
    "watch": "ng build --watch --configuration development",
    "lint": "eslint src",
    "test": "ng test",
    "e2e": "npx playwright test",
    "pw:open": "(cd e2e; docker compose pull && docker compose up --build -d) && npx playwright test --ui && (cd e2e; docker compose down)",
    "pw:open:sqlite": "(cd e2e; docker compose pull && docker compose -f 'docker-compose.yaml' -f 'docker-compose.sqlite.yaml' up --build -d) && npx playwright test --ui && (cd e2e; docker compose -f 'docker-compose.yaml' -f 'docker-compose.sqlite.yaml' down)",
    "pw:ci": "docker compose --profile ci -f 'e2e/docker-compose.yaml' up --build --exit-code-from playwright",
    "pw:ci:sqlite": "docker compose --profile ci -f 'e2e/docker-compose.yaml' -f 'e2e/docker-compose.sqlite.yaml' up --build --exit-code-from playwright"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.2.5",
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/localize": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@angular/router": "^22.2.4",
    "@angular/service-worker": "^22.2.4",
    "@googlemaps/js-api-loader": "^2.1.3",
    "@maplibre/maplibre-gl-geocoder": "^1.9.4",
    "@maplibre/ngx-maplibre-gl": "^22.3.1",
    "@ngx-formly/core": "11.0.0",
    "@stomp/rx-stomp": "^2.4.0",
    "@stomp/stompjs": "^7.5.0",
    "ag-grid-angular": "^36.2.0",
    "ag-grid-community": "^36.1.0",
    "array.prototype.at": "^1.2.0",
    "chess.js": "^1.4.0",
    "css-flatten": "^2.0.1",
    "d3": "^7.9.0",
    "dompurify": "^3.4.17",
    "europa": "^6.0.0",
    "europa-core": "^6.0.0",
    "file-saver": "^2.0.5",
    "globalthis": "^1.0.4",
    "handlebars": "^4.7.10",
    "he": "^2.0.0",
    "hls.js": "^1.7.4",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.2",
    "jtd": "^0.1.1",
    "katex": "^0.19.1",
    "lodash-es": "^4.18.1",
    "luxon": "^3.7.2",
    "maplibre-gl": "^6.16.0",
    "marked": "^18.1.2",
    "marked-katex-extension": "^5.1.13",
    "monaco-editor": "^0.57.0",
    "ngx-monaco-editor": "^12.0.0",
    "node-diff3": "3.2.1",
    "pele": "^1.12.0",
    "prismjs": "^1.30.0",
    "qrcode": "^1.5.4",
    "rxjs": "^7.4.0",
    "tslib": "^2.9.1",
    "uuid": "^14.0.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@angular/build": "22.2.5",
    "@angular/cli": "22.2.5",
    "@angular/compiler-cli": "^22.1.3",
    "@ngx-formly/schematics": "11.0.0",
    "@playwright/test": "^1.64.1",
    "@types/d3": "^7.4.3",
    "@types/file-saver": "^2.0.7",
    "@types/google.maps": "^3.66.9",
    "@types/he": "^1.2.3",
    "@types/lodash-es": "^4.17.12",
    "@types/luxon": "^3.7.6",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.1",
    "angular-eslint": "^22.5.0",
    "eslint": "^10.14.0",
    "jsdom": "^30.1.3",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "@angular/common": "$@angular/common",
    "@angular/core": "$@angular/core",
    "@angular/cdk": "$@angular/cdk",
    "@angular/platform-browser": "$@angular/platform-browser",
    "lodash-es": "$lodash-es",
    "dompurify": "$dompurify",
    "maplibre-gl": "$maplibre-gl",
    "marked": "$marked",
    "katex": "$katex",
    "uuid": "$uuid",
    "rxjs": "$rxjs",
    "monaco-editor": "$monaco-editor",
    "d3": "$d3"
  },
  "browser": {
    "fs": false,
    "os": false,
    "path": false
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "@parcel/watcher@2.5.6": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  }
}
